#pragma once

namespace Config {
// Wi-Fi station credentials. Leave as-is to boot straight into the fallback AP.
constexpr char WIFI_SSID[] = "YOUR_WIFI_SSID";
constexpr char WIFI_PASSWORD[] = "YOUR_WIFI_PASSWORD";

// Password for the fallback access point Delta-Bot starts when it cannot join
// a network. Must be at least 8 characters or the AP falls back to open.
constexpr char FALLBACK_AP_PASSWORD[] = "CHANGE_ME_AP";

// HTTP basic-auth credentials guarding every state-changing web endpoint.
// Leave WEB_PASSWORD empty to disable authentication (not recommended).
constexpr char WEB_USER[] = "delta";
constexpr char WEB_PASSWORD[] = "CHANGE_ME_WEB";
}
